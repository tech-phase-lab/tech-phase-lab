FROM python:3.12-slim

WORKDIR /app
COPY lib/research/providers.json lib/research/providers.json
COPY scripts/research/requirements.txt scripts/research/requirements.txt
RUN pip install --no-cache-dir -r scripts/research/requirements.txt
COPY scripts/research scripts/research

RUN useradd --create-home --uid 10001 monitor \
  && mkdir -p /data \
  && chown -R monitor:monitor /app /data

ENV PYTHONUNBUFFERED=1 \
    PORT=8080 \
    RESEARCH_DATA_DIR=/data \
    RESEARCH_FAST_POLL_SECONDS=3 \
    RESEARCH_STANDARD_POLL_SECONDS=5 \
    RESEARCH_REQUEST_TIMEOUT_SECONDS=20 \
    RESEARCH_PDF_EXTRACT_TIMEOUT_SECONDS=20
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 CMD ["python", "-c", "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8080/livez', timeout=4)"]
CMD ["python", "scripts/research/service.py"]
