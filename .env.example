# Website: URL and shared token for the always-on official-source monitor.
RESEARCH_MONITOR_URL=https://monitor.example.com
RESEARCH_MONITOR_TOKEN=replace-with-a-long-random-value

# Monitor service: use the same value as RESEARCH_MONITOR_TOKEN.
RESEARCH_API_TOKEN=replace-with-a-long-random-value
# Separate fail-closed token for the private editorial queue and review writes.
RESEARCH_EDITOR_TOKEN=replace-with-a-different-long-random-value
# Optional. Both values are required before one-at-a-time AI draft generation is enabled.
OPENAI_API_KEY=replace-only-after-explicitly-enabling-generation
RESEARCH_SUMMARY_MODEL=choose-an-approved-structured-output-model
# Disabled by default; requires both AI settings above.
RESEARCH_AUTO_DRAFTS=false
# Rolling 24-hour generation-job ceiling, including failed jobs.
RESEARCH_AUTO_DRAFT_DAILY_LIMIT=20
# Conservative rolling 24-hour token budget; requests reserve before sending.
RESEARCH_AUTO_DRAFT_TOKEN_LIMIT=100000
RESEARCH_AUTO_DRAFT_MAX_ATTEMPTS=3
RESEARCH_AUTO_DRAFT_INTERVAL_SECONDS=5
RESEARCH_FAST_POLL_SECONDS=3
RESEARCH_STANDARD_POLL_SECONDS=5
RESEARCH_REQUEST_TIMEOUT_SECONDS=20
RESEARCH_MAX_WORKERS=8
RESEARCH_BODY_FETCH_INTERVAL_SECONDS=10
RESEARCH_BODY_FETCH_BATCH=2
# Recent releases stay hot; unchanged historical bodies use the longer interval.
RESEARCH_HOT_BODY_RECHECK_SECONDS=900
RESEARCH_HOT_EVENT_WINDOW_SECONDS=86400
RESEARCH_BODY_RECHECK_SECONDS=21600
# Verified local backups on the monitor's private persistent volume.
RESEARCH_BACKUP_DIR=/data/backups
RESEARCH_BACKUP_INTERVAL_SECONDS=3600
RESEARCH_BACKUP_GRACE_SECONDS=600
RESEARCH_BACKUP_RETENTION=24
# Mark the service degraded if discovery cycles stop updating for this long.
RESEARCH_MONITOR_STALE_SECONDS=60
# Operational alerts are fail-closed. Enabling requires all four settings below.
RESEARCH_INCIDENT_DELIVERY_ENABLED=false
# Only transitions created at/after this UTC instant are eligible; older rows remain held.
RESEARCH_INCIDENT_DELIVERY_START_AT=2026-09-20T00:00:00Z
RESEARCH_INCIDENT_WEBHOOK_URL=https://alerts.example.com/tech-phase/incidents
RESEARCH_INCIDENT_WEBHOOK_TOKEN=replace-with-a-separate-long-random-webhook-token
RESEARCH_INCIDENT_DELIVERY_INTERVAL_SECONDS=5
RESEARCH_INCIDENT_DELIVERY_MAX_ATTEMPTS=5
RESEARCH_USER_AGENT=TechPhaseResearch/1.0 contact@example.com
